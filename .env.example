# MyTube environment
# Copy this file to .env and fill in values you actually use.
# Never commit real credentials. The YouTube and Supabase service-role
# keys must stay on the server — do not prefix them with VITE_.

# Server
PORT=8787
APP_URL=http://localhost:5173
NODE_ENV=development

# YouTube Data API v3 (server only)
YOUTUBE_API_KEY=

# Supabase (optional authentication and sync)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vite public copies of the anon key only (safe with Row Level Security)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional 4K enhancement (authorized files only). Install FFmpeg on PATH.
# ENHANCE_AI_BIN is an optional Real-ESRGAN binary; leave empty to use Lanczos only.
ENHANCE_AI_BIN=

# Movie discovery (server only). TMDB v3 key — never prefix with VITE_.
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Optional JustWatch Content Partner token. Leave empty unless you have a signed
# partner agreement. MyTube uses TMDB /movie/{id}/watch/providers (JustWatch data)
# and does not scrape JustWatch or piracy sites.
JUSTWATCH_PARTNER_TOKEN=

# Optional shared secret for GET /api/movies/jobs/refresh in production.
MOVIE_CRON_SECRET=

# Default OTT region. AE = United Arab Emirates.
DEFAULT_WATCH_REGION=AE

# Web Push (VAPID). Generated locally on first run in development.
# Chrome/Android PWAs use FCM through Web Push; iOS PWAs use APNs through Web Push.
# Native Play/App Store apps still update through those stores.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@localhost
